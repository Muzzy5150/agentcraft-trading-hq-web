NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SITE_URL=http://localhost:3000
STREAM_PROVIDER=none
STREAM_CHANNEL=
STREAM_VIDEO_ID=
TWITCH_PARENT=localhost
# Local publisher only. Outbound HTTPS is mandatory outside loopback development.
PUBLISH_URL=
ENGINE_URL=http://127.0.0.1:8787
ENGINE_LEDGER_PATH=
ENGINE_EVALUATIONS_PATH=
PUBLISHER_STATE_DIR=.publisher
